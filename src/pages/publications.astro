---
import { getCollection } from "astro:content"; import BaseLayout from "../layouts/BaseLayout.astro"; import PublicationItem from "../components/PublicationItem.astro";
const publications = (await getCollection("publications")).sort((a,b)=>b.data.year-a.data.year || (b.data.date?.valueOf() ?? 0)-(a.data.date?.valueOf() ?? 0)); const tags = [...new Set(publications.flatMap(p=>p.data.tags))]; const years = [...new Set(publications.map(p=>p.data.year))];
---
<BaseLayout title="Publications"><header class="page-header"><p class="eyebrow">Academic work</p><h1>Publications</h1><p class="lead">Research manuscripts and publications.</p></header><div class="filters" aria-label="Filter publications"><label>Year <select data-filter="year"><option value="">All years</option>{years.map(y=><option value={y}>{y}</option>)}</select></label><label>Topic <select data-filter="tag"><option value="">All topics</option>{tags.map(tag=><option value={tag}>{tag}</option>)}</select></label></div><div id="publication-list">{publications.map(p=><div data-publication data-year={p.data.year} data-tags={p.data.tags.join("|")}><PublicationItem publication={p} /></div>)}</div><script>const selects = document.querySelectorAll<HTMLSelectElement>('[data-filter]'); const entries = document.querySelectorAll<HTMLElement>('[data-publication]'); selects.forEach((select) => select.addEventListener('change', () => { const year = document.querySelector<HTMLSelectElement>('[data-filter="year"]')?.value ?? ''; const tag = document.querySelector<HTMLSelectElement>('[data-filter="tag"]')?.value ?? ''; entries.forEach((entry) => { entry.hidden = Boolean((year && entry.dataset.year !== year) || (tag && !entry.dataset.tags?.split('|').includes(tag))); }); }));</script></BaseLayout>
