---
import { getCollection } from "astro:content"; import profileImage from "../assets/profile.jpg"; import BaseLayout from "../layouts/BaseLayout.astro"; import SectionHeading from "../components/SectionHeading.astro"; import PublicationItem from "../components/PublicationItem.astro"; import UpdateItem from "../components/UpdateItem.astro"; import { site } from "../config/site";
const [publications, updates, education, teaching, experience] = await Promise.all([getCollection("publications"), getCollection("updates"), getCollection("education"), getCollection("teaching"), getCollection("experience")]);
const newest = updates.sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
const currentExperience = experience.filter(item => !item.data.endDate).sort((a, b) => b.data.startDate.localeCompare(a.data.startDate));
const currentOrganizations = Array.from(currentExperience.reduce((groups, item) => {
  const roles = groups.get(item.data.organization) ?? [];
  roles.push(item);
  groups.set(item.data.organization, roles);
  return groups;
}, new Map<string, typeof currentExperience>()).entries());
---
<BaseLayout>
  <section class="hero"><img class="profile-image" src={profileImage.src} alt={`Portrait of ${site.name}`} /><div><p class="eyebrow">{site.title}</p><h1>{site.name}</h1><p class="alternative-name"><span>Also known as</span>{" "}{site.alternativeName}</p><p class="university">{site.university}</p><p class="lead">{site.bio}</p><div class="socials">{site.socials.email && <a href={`mailto:${site.socials.email}`}>Email</a>}{site.socials.github && <a href={site.socials.github} rel="noopener noreferrer">GitHub</a>}{site.socials.scholar && <a href={site.socials.scholar}>Google Scholar</a>}{site.socials.linkedin && <a href={site.socials.linkedin}>LinkedIn</a>}<a href="/cv">CV</a></div></div></section>
  <section><SectionHeading title="Research interests" /><p class="tags">{site.researchInterests.map(tag => <span>{tag}</span>)}</p></section>
  <section><SectionHeading title="Currently" /><ul class="now-list">{site.now.map(item => <li>{item}</li>)}</ul></section>
  <section><SectionHeading title="Latest updates" href="/updates" linkLabel="View all updates" />{newest.map(update => <UpdateItem update={update} />)}</section>
  <section><SectionHeading title="Selected publications" href="/publications" />{publications.filter(p=>p.data.featured).sort((a,b)=>b.data.year-a.data.year).map(publication => <PublicationItem publication={publication} />)}</section>
  {education.length > 0 && <section><SectionHeading title="Education" />{education.map(item => <article class="timeline-item"><h3>{item.data.degree} in {item.data.field}</h3><p>{item.data.institution} · <span class="status">{item.data.status}</span>{item.data.startDate && <> · {item.data.startDate}{item.data.endDate && ` – ${item.data.endDate}`}</>}</p></article>)}</section>}
  {currentOrganizations.length > 0 && <section><SectionHeading title="Current roles" href="/experience" linkLabel="View experience" />{currentOrganizations.map(([organization, roles]) => <article class="current-organization"><h3>{organization}</h3>{roles.map(item => <article class="timeline-item"><h4>{item.data.role}</h4><p><span class="status">{item.data.startDate} – Present</span></p></article>)}</article>)}</section>}
  {teaching.length > 0 && <section><SectionHeading title="Teaching" /><div class="teaching-tags">{teaching.map(item => <article class="teaching-tag"><span>{item.data.courseCode}{item.data.courseName && ` — ${item.data.courseName}`}</span><small>{item.data.institution}</small></article>)}</div></section>}
</BaseLayout>

<style>
  .teaching-tags { margin-top: 1rem; }
  .current-organization > h3 { margin-bottom: 1rem; }
  .current-organization .timeline-item h4 { margin: 0; }
  .alternative-name { align-items: center; background: color-mix(in srgb, var(--color-accent) 10%, transparent); border: 1px solid color-mix(in srgb, var(--color-accent) 28%, transparent); border-radius: 99px; color: var(--color-accent); display: inline-flex; font-family: Georgia, "Times New Roman", serif; font-size: 0.92rem; gap: 0.45rem; margin: 0 0 0.65rem; padding: 0.18rem 0.65rem 0.22rem; }
  .alternative-name span { font: inherit; }
</style>
